# Aruba Central MCP Server — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Required ──────────────────────────────────────────────────────────────

# Aruba Central API Gateway base URL for your region (no trailing slash):
#   US-East:  https://apigw-prod2.central.arubanetworks.com
#   US-West:  https://apigw-uswest4.central.arubanetworks.com
#   EU:       https://apigw-eucentral3.central.arubanetworks.com
#   APAC:     https://apigw-apnortheast.central.arubanetworks.com
#   Canada:   https://apigw-cacentral.central.arubanetworks.com
ARUBA_CENTRAL_BASE_URL=https://apigw-prod2.central.arubanetworks.com

# OAuth2 access_token from HPE GreenLake / Aruba Central API Gateway.
# Generate via: Account Home → API Gateway → System Apps & Tokens → Add Token
# Tokens are short-lived (2 hours by default). Use a refresh token flow for automation.
ARUBA_CENTRAL_TOKEN=your_access_token_here
